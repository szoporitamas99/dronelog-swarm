# Documentation only: docker stack deploy does not load this file automatically.
# PowerShell: $env:DOCKERHUB_USER = "your-docker-hub-user"
# PowerShell: $env:APP_TAG = "1.0.0"
# Bash: export DOCKERHUB_USER=your-docker-hub-user APP_TAG=1.0.0
DOCKERHUB_USER=your-docker-hub-user
APP_TAG=1.0.0
# Do not put passwords or tokens here. scripts/deploy.* creates Docker secrets.
